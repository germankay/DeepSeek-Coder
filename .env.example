# CyberCode Studio - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# API Configuration
HOST=0.0.0.0
PORT=8000
API_KEY=cybercode-secret-key-change-in-production
ENVIRONMENT=production

# TLS / Security Configuration
TLS_ENABLED=true
SSL_KEYFILE=/etc/certs/privkey.pem
SSL_CERTFILE=/etc/certs/fullchain.pem

# HashiCorp Vault Integration
VAULT_ENABLED=false
VAULT_ADDR=https://vault.cybercode.studio:8200
VAULT_TOKEN=

# Model Configuration (Strictly DeepSeek-Coder V1 Models)
DEFAULT_MODEL_NAME=deepseek-ai/deepseek-coder-6.7b-instruct
VLLM_MODEL_NAME=deepseek-ai/deepseek-coder-6.7b-instruct
QUANTIZATION=bitsandbytes

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
